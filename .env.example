# Django Core Settings
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-key-64-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration (MySQL 8.x for Production, sqlite3 for Local Dev)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=black_eagles_zipline
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email / SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Black Eagles Zipline <noreply@blackeagleszipline.com>

